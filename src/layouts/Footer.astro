---
import heartIcon from "pixelarticons/svg/heart.svg?url";
import copyrightIcon from "pixelarticons/svg/copyright.svg?url";

import Link from "@/components/ui/Link.astro";
import "@/styles/footer.css";
import { getPortfolioData } from "@/lib/server/portfolio-cache";

import { defaultLocale, type locale } from "@/lib/i18n/locales";
import { useTranslations } from "@/lib/i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
const currentLocale = (Astro.currentLocale ?? defaultLocale) as locale;
const t = useTranslations(currentLocale);

const { profile} = await getPortfolioData(currentLocale);
const fullName = [profile?.first_name, profile?.last_name]
    .filter(Boolean)
    .join(" ");
---

<footer class="footer">
    <nav class="footer__nav" aria-label="Footer navigation">
        <Link href={getRelativeLocaleUrl(currentLocale, "imprint")} variant="ghost">
            {t("footer.imprint")}
        </Link>
        <Link href={getRelativeLocaleUrl(currentLocale, "privacy_policy")} variant="ghost">
            {t("footer.privacy")}
        </Link>
    </nav>

    <p class="footer__made-with">
        {t("footer.madeWithBeforeHeart")}
    <span
            class="footer__icon"
            style={`--icon-url: url("${heartIcon}")`}
            aria-hidden="true"
    ></span>
        {t("footer.madeWithAfterHeart", { name: fullName || "..." })}
    </p>

    <p class="footer__copyright">
    <span
            class="footer__icon"
            style={`--icon-url: url("${copyrightIcon}")`}
            aria-hidden="true"
    ></span>
        {t("footer.copyright", { name: fullName })}
    </p>
</footer>
