---
import heartIcon from "pixelarticons/svg/heart.svg?url";
import copyrightIcon from "pixelarticons/svg/copyright.svg?url";

import Link from "@/components/ui/Link.astro";
import "@/styles/footer.css";
---

<footer class="footer">
    <nav class="footer__nav" aria-label="Footer navigation">
        <Link href="/imprint" variant="ghost">Imprint</Link>
        <Link href="/privacy_policy" variant="ghost">Privacy Policy</Link>
    </nav>

    <p class="footer__made-with">
        Made with
        <span
            class="footer__icon"
            style={`--icon-url: url("${heartIcon}")`}
            aria-label="love"
            role="img"
        ></span>
        by Tobias Plank and help of AI.
    </p>


    <p class="footer__copyright">
        <span
            class="footer__icon"
            style={`--icon-url: url("${copyrightIcon}")`}
            aria-label="copyright"
            role="img"
        ></span>
        2026 Tobias Plank. All rights reserved.
    </p>
</footer>
