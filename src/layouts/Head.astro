---
import { baseData } from "@/data/siteData.ts";
const { title = baseData.title, description = baseData.description } = Astro.props;
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicon (initial leer bzw. Fallback) -->
    <link id="app-favicon" rel="icon" type="image/svg+xml" href="/favicon_dark.svg" />

    <script is:inline>
        function updateFavicon(isDark) {
            const baseHref = isDark ? "/favicon_dark.svg" : "/favicon_light.svg";

            // WICHTIG: Cache-Buster zwingt Firefox zum sofortigen Neuzeichnen des Tabs
            const newHref = baseHref + "?v=" + Date.now();

            // Bestehende Favicon-Tags entfernen
            const oldLinks = document.querySelectorAll("link[rel*='icon']");
            oldLinks.forEach((link) => link.remove());

            // Neuen Link-Tag erstellen und in den Head einhängen
            const newLink = document.createElement("link");
            newLink.id = "app-favicon";
            newLink.rel = "icon";
            newLink.type = "image/svg+xml";
            newLink.href = newHref;
            document.head.appendChild(newLink);
        }

        function checkIsDark() {
            const html = document.documentElement;
            const theme = html.dataset.theme;

            // Erkennt sowohl data-theme="dark" als auch class="dark" (Tailwind)
            if (theme) return theme === "dark";
            if (html.classList.contains("dark")) return true;

            // Fallback auf localStorage oder Betriebssystem
            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) return savedTheme === "dark";

            return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        function applyTheme() {
            const isDark = checkIsDark();

            // Synchronisiere data-theme & Klasse, falls noch nicht geschehen
            document.documentElement.dataset.theme = isDark ? "dark" : "light";
            updateFavicon(isDark);
        }

        // 1. Sofort vor dem ersten Rendern ausführen
        applyTheme();

        // 2. DOM-Observer: Reagiert auf 'data-theme' UND auf 'class' (z.B. class="dark")
        const observer = new MutationObserver(() => {
            const isDark = checkIsDark();
            updateFavicon(isDark);
        });

        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme", "class"],
        });

        // 3. Reagiert auf OS-Wechsel
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
            if (!localStorage.getItem("theme")) {
                document.documentElement.dataset.theme = e.matches ? "dark" : "light";
                updateFavicon(e.matches);
            }
        });
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
</head>