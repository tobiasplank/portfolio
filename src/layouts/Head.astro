---
import { baseData } from "@/data/siteData.ts";
const { title = baseData.title, description = baseData.description } = Astro.props;
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicon (initially empty or fallback) -->
    <link id="app-favicon" rel="icon" type="image/svg+xml" href="/favicon_dark.svg" />

    <script is:inline>
        function updateFavicon(isDark) {
            const baseHref = isDark ? "/favicon_dark.svg" : "/favicon_light.svg";

            // IMPORTANT: The cache-buster forces Firefox to redraw the tab immediately
            const newHref = baseHref + "?v=" + Date.now();

            // Remove existing favicon tags
            const oldLinks = document.querySelectorAll("link[rel*='icon']");
            oldLinks.forEach((link) => link.remove());

            // Create a new link tag and append it to the head
            const newLink = document.createElement("link");
            newLink.id = "app-favicon";
            newLink.rel = "icon";
            newLink.type = "image/svg+xml";
            newLink.href = newHref;
            document.head.appendChild(newLink);
        }

        function checkIsDark() {
            const html = document.documentElement;
            const theme = html.dataset.theme;

            // Detect both data-theme="dark" and class="dark" (Tailwind)
            if (theme) return theme === "dark";
            if (html.classList.contains("dark")) return true;

            // Fall back to localStorage or the operating system
            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) return savedTheme === "dark";

            return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        function applyTheme() {
            const isDark = checkIsDark();

            // Synchronize data-theme and the class if not already done
            document.documentElement.dataset.theme = isDark ? "dark" : "light";
            updateFavicon(isDark);
        }

        // 1. Run immediately before the first render
        applyTheme();

        // 2. DOM observer: Responds to both 'data-theme' and 'class' (e.g. class="dark")
        const observer = new MutationObserver(() => {
            const isDark = checkIsDark();
            updateFavicon(isDark);
        });

        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme", "class"],
        });

        // 3. Respond to operating system theme changes
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
            if (!localStorage.getItem("theme")) {
                document.documentElement.dataset.theme = e.matches ? "dark" : "light";
                updateFavicon(e.matches);
            }
        });
    </script>

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
</head>