---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import ComingSoon from "@/components/ComingSoon.astro"
---

<Layout title="Projects">
    <Hero
        staticText="Projects"
        dynamicText={false}
        compact={true}
        tagSize="h1"
    />
    <ComingSoon
        icon="list-box"
        iconColor="var(--color-accent-purple)"
        subheading="The project section is planned for the future"
        description="Here I'll publish details to my most interesting projects.<br>
        For example about this portfolio and its infrastructure."
    />
</Layout>