---
import "@/styles/ui/toggle_theme.css";

import sunIcon from "pixelarticons/svg/sun.svg?url";
import sunSolidIcon from "pixelarticons/svg/sun-solid.svg?url";

import moonIcon from "pixelarticons/svg/moon.svg?url";
import moonSolidIcon from "pixelarticons/svg/moon-solid.svg?url";
---

<button
        class="theme-toggle"
        type="button"
        aria-label="Activate dark mode"
        aria-pressed="false"
>
    <span class="theme-icon-set theme-icon-set--sun">
        <span
                class="theme-icon theme-icon--regular"
                style={`--icon-url: url("${sunIcon}")`}
                aria-hidden="true"
        ></span>

        <span
                class="theme-icon theme-icon--solid"
                style={`--icon-url: url("${sunSolidIcon}")`}
                aria-hidden="true"
        ></span>
    </span>

    <span class="theme-icon-set theme-icon-set--moon">
        <span
                class="theme-icon theme-icon--regular"
                style={`--icon-url: url("${moonIcon}")`}
                aria-hidden="true"
        ></span>

        <span
                class="theme-icon theme-icon--solid"
                style={`--icon-url: url("${moonSolidIcon}")`}
                aria-hidden="true"
        ></span>
    </span>
</button>

<script>
    type Theme = "light" | "dark";

    const button = document.querySelector<HTMLButtonElement>(
        ".theme-toggle",
    );

    const getCurrentTheme = (): Theme => {
        return document.documentElement.dataset.theme === "light"
            ? "light"
            : "dark";
    };

    const updateButtonState = (theme: Theme) => {
        button?.setAttribute(
            "aria-pressed",
            String(theme === "dark"),
        );

        button?.setAttribute(
            "aria-label",
            theme === "dark"
                ? "Activate light mode"
                : "Activate dark mode",
        );
    };

    updateButtonState(getCurrentTheme());

    let flashTimer: ReturnType<typeof setTimeout> | null = null;
    let isTouch = false;

    button?.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") {
            button.classList.add("theme-toggle--hover");
        }
    });

    button?.addEventListener("pointerleave", () => {
        button.classList.remove("theme-toggle--hover");
    });

    button?.addEventListener("pointerdown", (event) => {
        isTouch = event.pointerType === "touch" || event.pointerType === "pen";
        if (isTouch) {
            button.classList.remove("theme-toggle--hover");
        }
    });

    button?.addEventListener("click", () => {
        const nextTheme: Theme =
            getCurrentTheme() === "dark"
                ? "light"
                : "dark";

        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);

        updateButtonState(nextTheme);

        if (button) {
            button.blur();

            if (isTouch) {
                button.classList.remove("theme-toggle--hover");
                button.classList.add("theme-toggle--flash");
                if (flashTimer) clearTimeout(flashTimer);
                flashTimer = setTimeout(() => {
                    button.classList.remove("theme-toggle--flash");
                }, 300);
            }
        }
    });
</script>