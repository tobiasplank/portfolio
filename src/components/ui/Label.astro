---
import type { HTMLAttributes } from "astro/types";

export type LabelSize = "S" | "M" | "L";

interface Props extends HTMLAttributes<"span"> {
    size?: LabelSize;
    liveStatus?: boolean;
    statusColor?: string;
}

const {
    size = "M",
    liveStatus = false,
    statusColor,
    class: className,
    style,
    ...rest
} = Astro.props;

const customStyle = [
    statusColor ? `--status-color: ${statusColor}` : "",
    typeof style === "string" ? style : "",
].filter(Boolean).join("; ");
---

<span
    class:list={[
        "label",
        `label--${size.toLowerCase()}`,
        { "label--live": liveStatus },
        className,
    ]}
    style={typeof style === "object" ? { ...(statusColor ? { "--status-color": statusColor } : {}), ...style } : (customStyle || undefined)}
    {...rest}
>
    {liveStatus && <span class="label__status" aria-hidden="true" />}
    <slot />
</span>

<style>
    .label {
        --status-color: var(--color-accent);

        display: inline-flex;
        align-items: center;
        font-family: "Departure Mono", monospace;
        line-height: 1.2;
        color: var(--color-text);
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: 4px;
        box-sizing: border-box;
    }

    .label--s {
        font-size: 0.75rem;
        padding: 0.2rem 0.45rem;
        gap: 0.35rem;
    }

    .label--m {
        font-size: 0.8rem;
        padding: 0.3rem 0.65rem;
        gap: 0.45rem;
    }

    .label--l {
        font-size: 0.95rem;
        padding: 0.4rem 0.85rem;
        gap: 0.55rem;
    }

    .label--live {
        border-color: var(--status-color);
    }

    .label--live.label--s {
        padding-left: 0.35rem;
    }

    .label--live.label--m {
        padding-left: 0.45rem;
    }

    .label--live.label--l {
        padding-left: 0.55rem;
    }

    .label__status {
        display: inline-block;
        flex-shrink: 0;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--status-color);
        box-shadow: 0 0 8px var(--status-color);
    }

    .label--s .label__status {
        width: 6px;
        height: 6px;
    }

    .label--l .label__status {
        width: 10px;
        height: 10px;
    }
</style>
