---
import closeIcon from "pixelarticons/svg/close.svg?url";

interface Props {
    id?: string;
}

const { id = "polaroid-modal" } = Astro.props;
---

<dialog id={id} class="polaroid-modal">
    <!-- Close-Button oben rechts am Bildschirm -->
    <button type="button" class="modal-close-btn" aria-label="Schließen">
        <img src={closeIcon} alt="Close" />
    </button>

    <!-- Klick-Erkennung außerhalb: Dialog füllt Backdrop, Wrapper ist der Content -->
    <div class="modal-content">
        <div class="modal-image-wrapper">
            <img id="modal-img" src="" alt="" />
        </div>

        <div class="modal-info">
            <h3 id="modal-caption"></h3>
            <p id="modal-description"></p>
        </div>
    </div>
</dialog>

<style>
    .polaroid-modal {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 2rem;
        border: none;
        background: transparent;
        display: none;
        place-items: center;
        box-sizing: border-box;
        z-index: 99999;
    }

    .polaroid-modal[open] {
        display: grid;
    }

    /* Stark abgedunkelter Hintergrund */
    .polaroid-modal::backdrop {
        background-color: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
    }

    /* Close-Button fest oben rechts auf dem Viewport */
    .modal-close-btn {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        background: rgb(251 251 248);
    }

    .modal-close-btn img {
        width: 2rem;
        height: 2rem;
        display: block;

        mask: var(--icon-url) center / contain no-repeat;
        -webkit-mask: var(--icon-url) center / contain no-repeat;
    }

    /* Content-Bereich */
    .modal-content {
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .modal-image-wrapper {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 0;
    }

    #modal-img {
        max-width: 100%;
        max-height: 75vh;
        object-fit: contain;
        border-radius: 4px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .modal-info {
        text-align: center;
        color: #fff;
    }

    #modal-caption {
        font-size: 1.25rem;
        margin: 0 0 0.5rem 0;
    }

    #modal-description {
        font-size: 0.95rem;
        margin: 0;
        opacity: 0.85;
        max-width: 600px;
    }
</style>

<script>
    function setupModal() {
        const dialog = document.querySelector<HTMLDialogElement>('.polaroid-modal');
        if (!dialog) return;

        const closeBtn = dialog.querySelector('.modal-close-btn');
        const content = dialog.querySelector('.modal-content');
        const img = dialog.querySelector<HTMLImageElement>('#modal-img');
        const caption = dialog.querySelector('#modal-caption');
        const description = dialog.querySelector('#modal-description');

        function closeModal() {
            dialog?.close();
        }

        closeBtn?.addEventListener('click', closeModal);

        // Klick außerhalb des Contents schließt das Modal
        dialog.addEventListener('click', (e) => {
            if (content && !content.contains(e.target as Node)) {
                closeModal();
            }
        });

        // Event-Listener: Hört auf den Click aus dem PolaroidStack
        window.addEventListener('open-polaroid-modal', ((e: CustomEvent) => {
            const data = e.detail;
            if (!data) return;

            if (img) img.src = data.src || '';
            if (caption) caption.textContent = data.caption || '';
            if (description) description.textContent = data.description || '';

            dialog.showModal();
        }) as EventListener);
    }

    setupModal();
    document.addEventListener('astro:page-load', setupModal);
</script>